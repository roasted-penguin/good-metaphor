# `cp .env.example .env` 후 .env에만 키를 넣는다(.env는 커밋하지 않는다).
# 비워 두어도 서버는 뜨고 /health는 200이에요(비유 요청만 막혀요).
GEMINI_API_KEY=
# CORS(T-141). 기본은 닫힘. 운영은 확장 출처를 쉼표로 적어요(예: chrome-extension://<확장 id 32자>).
ALLOWED_ORIGINS=
# 개발 중에만 true: 모든 확장 id 형식(chrome-extension://[a-p]{32})을 허용해요. 운영에서는 비워 두세요.
ALLOW_EXTENSION_ORIGINS=
